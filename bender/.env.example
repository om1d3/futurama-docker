# =
# bender (TrueNAS Scale) - Environment Variables
# Version: 104 - Switched to OpenVPN, cleaned up unused variables
# =
# IMPORTANT: This file contains secrets - protect accordingly
# chmod 600 /mnt/BIG/filme/docker-compose/.env
# =
# v104 CHANGES:
#   - REMOVED: SURFSHARK_WG_PRIVATE_KEY (switched to OpenVPN)
#   - REMOVED: SURFSHARK_WG_ADDRESS (switched to OpenVPN)
#   - REMOVED: DIUN_NTFY_ENDPOINT (unused, diun uses NTFY_ADDRESS)
#   - ADDED: SURFSHARK_OPENVPN_USER and SURFSHARK_OPENVPN_PASSWORD
# =

# =
# SYSTEM
# =
TIMEZONE=
PUID=
PGID=
LOCAL_NETWORK=
BENDER_HOST_IP=

# =
# PATHS (reference only - not used by docker-compose)
# =
BASE_PATH=
CONFIG_PATH=

# =
# TAILSCALE
# =
TAILSCALE_DOMAIN=
TSDPROXY_AUTHKEY=

# =
# SYNCTHING
# =
SYNCTHING_HOSTNAME=

# =
# SURFSHARK OPENVPN (for Gluetun)
# =
# Get credentials from: Surfshark → Manual setup → Router/Other → OpenVPN
SURFSHARK_OPENVPN_USER=
SURFSHARK_OPENVPN_PASSWORD=

# Server location for Gluetun
GLUETUN_SERVER_COUNTRY=

# =
# OLD OPENVPN CREDENTIALS (kept for reference - no longer used)
# =
# These were used by the old haugene/transmission-openvpn container
# Keeping them commented for historical reference
# TRANSMISSION_VPN_PROVIDER=
# TRANSMISSION_VPN_OPENVPN_CONFIG=
# TRANSMISSION_VPN_USERNAME=
# TRANSMISSION_VPN_PASSWORD=

# =
# POSTGRESQL (used by Immich, HedgeDoc)
# =
POSTGRES_PASSWORD=

# =
# HEDGEDOC
# =
# Generate with: openssl rand -hex 32
HEDGEDOC_SESSION_SECRET=
HEDGEDOC_DOMAIN=

# =
# VAULTWARDEN
# =
# Generate with: echo "$(openssl rand -base64 48)"
# Or use argon2 hash for better security
VAULTWARDEN_ADMIN_TOKEN=

# =
# BESZEL AGENT
# =
BESZEL_KEY=
BESZEL_TOKEN=

# =
# PI-HOLE
# =
PIHOLE_PASSWORD=

# =
# NTFY NOTIFICATIONS
# =
# Used by diun and other services for push notifications
NTFY_ADDRESS=
DIUN_NTFY_TOPIC=

# =
# ARR STACK API KEYS
# =
# Get from each app's Settings → General → API Key
# Leave empty if not using the specific arr app
SONARR_API_KEY=
RADARR_API_KEY=
LIDARR_API_KEY=
READARR_API_KEY=

# =
# SILVERBULLET (commented out - for future use)
# =
# Uncomment when ready to deploy SilverBullet
# Format: username:password (e.g., admin:YourSecurePassword)
# SILVERBULLET_USER=

# =
# KEEPALIVED
# =
# Password must be the same on both bender and amy
KEEPALIVED_PASSWORD=
# to be reused --> K2tRVXiQYM8nQWy8wUi6xXJoN4KHfLf4
# =
# KEEPALIVED_VIP is the floating IP for pi-hole HA
KEEPALIVED_VIP=
# =
