# ============================================
# bender (TrueNAS Scale) - Environment Variables
# Version: 109
# ============================================
# IMPORTANT: Copy this file to .env and fill in secrets
#   cp .env.example .env && chmod 600 .env
# ============================================

# ============================================
# SYSTEM
# ============================================
TIMEZONE=America/Toronto
PUID=1000
PGID=1000
LOCAL_NETWORK=192.168.21.0/24
BENDER_HOST_IP=192.168.21.121

# ============================================
# PATHS (reference only - not used by docker-compose)
# ============================================
BASE_PATH=/mnt/BIG/filme
CONFIG_PATH=/mnt/BIG/filme/configs

# ============================================
# TAILSCALE
# ============================================
TAILSCALE_DOMAIN=bunny-enigmatic.ts.net
TSDPROXY_AUTHKEY=

# ============================================
# SYNCTHING
# ============================================
SYNCTHING_HOSTNAME=bender

# ============================================
# SURFSHARK OPENVPN (for Gluetun)
# ============================================
# Get credentials from: Surfshark → Manual setup → Router/Other → OpenVPN
SURFSHARK_OPENVPN_USER=
SURFSHARK_OPENVPN_PASSWORD=

# Server location for Gluetun
GLUETUN_SERVER_COUNTRY=Romania

# ============================================
# POSTGRESQL (used by Immich, HedgeDoc)
# ============================================
POSTGRES_PASSWORD=

# ============================================
# HEDGEDOC
# ============================================
# Generate with: openssl rand -hex 32
HEDGEDOC_SESSION_SECRET=
HEDGEDOC_DOMAIN=pad.bunny-enigmatic.ts.net

# ============================================
# VAULTWARDEN
# ============================================
# Generate with: echo "$(openssl rand -base64 48)"
# Or use argon2 hash for better security
VAULTWARDEN_ADMIN_TOKEN=

# ============================================
# BESZEL AGENT
# ============================================
BESZEL_KEY=
BESZEL_TOKEN=

# ============================================
# PI-HOLE
# ============================================
PIHOLE_PASSWORD=

# ============================================
# NTFY NOTIFICATIONS
# ============================================
# Used by diun and other services for push notifications
NTFY_ADDRESS=http://192.168.21.130:8080
DIUN_NTFY_TOPIC=container-updates-bender

# ============================================
# ARR STACK API KEYS
# ============================================
# Get from each app's Settings → General → API Key
# Leave empty if not using the specific arr app
SONARR_API_KEY=
RADARR_API_KEY=
LIDARR_API_KEY=
READARR_API_KEY=

# ============================================
# KEEPALIVED
# ============================================
# Password must be the same on both bender and amy
KEEPALIVED_PASSWORD=
KEEPALIVED_VIP=192.168.21.100
