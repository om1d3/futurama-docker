# ============================================
# futurama-docker
# ============================================
# This repository is populated by futurama-sync.sh, which copies only an
# explicit manifest of files into a neutral clone. So this file is a SAFETY
# NET, not a working filter. If a rule here ever fires, the manifest is
# wrong and should be fixed instead.
#
# The repository is PUBLIC on GitHub. Nothing in plaintext here may contain
# a credential. Secrets are committed only as .gpg ciphertext.
# ============================================

# ---- plaintext secrets: never ----
.env
.env.*
*.env
secrets.yaml
secrets.yml
secrets.json
password*.txt
credentials.json
# ciphertext is the point of this repository
!*.gpg
!.env.example

# ---- keys and certificates ----
*.key
*.pem
*.p12
*.pfx
*.crt
*.cer
*.csr
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
*.ppk

# ---- generated state: belongs in backups, not git ----
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.mv.db
*.MAD
state.json
logos.json
gravity*.db
listsCache/

# ---- versioned backups: git IS the version history ----
*.backup
*.bak
*.bak2
*.OLD
*_OLD
*.old
*.orig
*.tmp
*.temp
*_WRONG

# ---- logs and reports ----
*.log
logs/
reports/

# ---- build and runtime artifacts ----
venv/
__pycache__/
*.pyc
node_modules/

# ---- archives may hide anything ----
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar

# ---- nested repositories ----
# configs/audiobook-foundry is its own git checkout and must not be nested
audiobook-foundry/
nod-config.git/

# ---- editor and OS noise ----
.DS_Store
._*
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
