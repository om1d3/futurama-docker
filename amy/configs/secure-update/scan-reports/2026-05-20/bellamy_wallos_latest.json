          "created": "2026-05-07T16:49:22Z",
          "created_by": "RUN /bin/sh -c set -eux; \tcd \"${PHP_INI_DIR%/php}\"; \t\tcp -v php-fpm.conf.default php-fpm.conf; \tcp -v php-fpm.d/www.conf.default php-fpm.d/www.conf; \t\tgrep -E '^listen = 127.0.0.1:9000' php-fpm.d/www.conf; \tsed -ri 's/^(listen = 127.0.0.1:9000)/;\\1/' php-fpm.d/www.conf; \tgrep -E '^;listen = 127.0.0.1:9000' php-fpm.d/www.conf; \t\t{ \t\techo '[global]'; \t\techo 'error_log = /proc/self/fd/2'; \t\techo; echo '; https://github.com/docker-library/php/pull/725#issuecomment-443540114'; echo 'log_limit = 8192'; \t\techo; \t\techo '[www]'; \t\techo '; php-fpm closes STDOUT on startup, so sending logs to /proc/self/fd/1 does not work.'; \t\techo '; https://bugs.php.net/bug.php?id=73886'; \t\techo 'access.log = /proc/self/fd/2'; \t\techo; \t\techo 'clear_env = no'; \t\techo; \t\techo '; Ensure worker stdout and stderr are sent to the main error log.'; \t\techo 'catch_workers_output = yes'; \t\techo 'decorate_workers_output = no'; \t\techo; \t\techo '; default listen address for easy override in later php-fpm.d/*.conf files'; \t\techo 'listen = 9000'; \t} | tee php-fpm.d/docker.conf; \t{ \t\techo '[global]'; \t\techo 'daemonize = no'; \t\techo; \t\techo '; the [www] ini section below is for backwards compatibility and will be removed in 8.6+'; \t\techo '[www]'; \t} | tee php-fpm.d/zz-docker.conf; \tmkdir -p \"$PHP_INI_DIR/conf.d\"; \t{ \t\techo '; https://github.com/docker-library/php/issues/878#issuecomment-938595965'; \t\techo 'fastcgi.logging = Off'; \t} \u003e \"$PHP_INI_DIR/conf.d/docker-fpm.ini\" # buildkit",
